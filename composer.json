{
    "name": "kode/session",
    "description": "kode/session - 分布式会话管理器，支持文件、Redis、Cookie、内存等驱动",
    "license": "Apache-2.0",
    "type": "library",
    "keywords": [
        "session",
        "cache",
        "distributed",
        "redis",
        "file",
        "cookie",
        "fiber",
        "coroutine",
        "psr-15",
        "kode"
    ],
    "authors": [
        {
            "name": "kode",
            "email": "382601296@qq.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "kode/context": "^2.3",
        "psr/http-message": "^1.0|^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0",
        "mockery/mockery": "^1.6",
        "predis/predis": "^2.0"
    },
    "suggest": {
        "ext-redis": "使用 phpredis 扩展获得更好的 Redis 驱动性能",
        "predis/predis": "无 phpredis 扩展时作为 Redis 客户端替代方案",
        "ext-pcntl": "ParallelSession::fork() 多进程支持",
        "ext-sockets": "ParallelSession::fork() 父子进程数据回传"
    },
    "autoload": {
        "psr-4": {
            "Kode\\Session\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kode\\Session\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    }
}
